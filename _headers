# Regras de cache do Cloudflare Pages.
# Formato: caminho, e embaixo os cabecalhos indentados.

# O jogo e o service worker precisam ser sempre conferidos na rede,
# senao um tablet continuaria rodando a versao antiga depois do deploy.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Codigo: pode ficar um pouco no cache, mas revalida sozinho.
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  Cache-Control: public, max-age=0, must-revalidate

# Fotos e icones nunca mudam de conteudo: podem ficar guardados por um ano.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
